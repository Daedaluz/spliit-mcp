# Configuration for the local test stack (compose.dev.yml).
#
#   cp .env.example .env
#
# Anything commented out has a working default; uncomment only to change it.
# Every SPLIIT_MCP_* variable the server understands can be set here, not just
# the ones listed — see config.example.yaml for the full set.

# ---------------------------------------------------------------------- OIDC
# Required. No identity provider ships with the stack; point these at yours.
#
# The issuer must resolve to the same URL from your browser and from inside the
# containers. A public issuer does so automatically. For a provider running on
# your own machine, use host.docker.internal and make your browser agree with
# it — see COMPOSE.md.
SPLIIT_MCP_OIDC_ISSUER=https://id.example.com
SPLIIT_MCP_OIDC_CLIENT_ID=spliit-mcp
SPLIIT_MCP_OIDC_CLIENT_SECRET=

# Register this redirect URI with your provider:
#   http://localhost:8080/auth/callback

# For MCP clients whose authorization server does not support Dynamic Client
# Registration, pre-register a public client with PKCE and put its ID here.
#SPLIIT_MCP_OIDC_MCP_CLIENT_ID=spliit-mcp-client

# Bearer tokens are checked for an audience of http://localhost:8080/mcp. If
# your provider cannot bind audiences, disable the check — it is the protection
# against replaying a token minted for another service, so prefer fixing the
# provider.
#SPLIIT_MCP_OIDC_SKIP_AUDIENCE_CHECK=true

# Scopes required on MCP bearer tokens; empty means any valid token is enough.
#SPLIIT_MCP_OIDC_REQUIRED_SCOPES=

# --------------------------------------------------------------------- Ports
#MCP_PORT=8080
#SPLIIT_PORT=3000

# If you change MCP_PORT, change this to match; it must be the URL you actually
# open, since the OIDC redirect URI and token audience are built from it.
#SPLIIT_MCP_PUBLIC_URL=http://localhost:8080

# ------------------------------------------------------------------- Spliit
# Upstream ref to build the bundled Spliit instance from.
#SPLIIT_REF=v1.19.0

# Point new users at a different Spliit instance instead of the bundled one.
#SPLIIT_MCP_SPLIIT_DEFAULT_URL=https://spliit.app/api/trpc
#SPLIIT_MCP_SPLIIT_DEFAULT_NAME=spliit.app

# ----------------------------------------------------------------- Databases
#SPLIIT_DB_PASSWORD=spliit
#MCP_DB_PASSWORD=spliitmcp

# --------------------------------------------------------------------- Misc
#COMPOSE_PROJECT=spliit-mcp-dev
#GIN_MODE=debug
