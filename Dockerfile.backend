FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# CGO stays off: the SQLite driver is modernc.org/sqlite, which is pure Go.
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/spliit-mcp ./cmd/spliit-mcp

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/spliit-mcp /spliit-mcp
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/spliit-mcp", "serve"]
